<Ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns="http://www.blizzard.com/wow/ui/">
	<!-- Dialog Window -->
	<Script file="StoryTellerDialogTemplate.lua" />
	<Frame name="StoryTellerDialogTemplate" parent="UIParent" toplevel="true" enableMouse="true" movable="true" hidden="true" clampedtoscreen="true" frameStrata="DIALOG" virtual="true" mixin="StoryTellerDialogTemplateMixin">
		<Scripts>
			<OnLoad function="StoryTellerDialogTemplate_OnLoad" />
			<OnDragStart function="StoryTellerDialogTemplate_OnDragStart" />
			<OnDragStop function="StoryTellerDialogTemplate_OnDragStop" />
			<OnShow function="StoryTellerDialogTemplate_OnShow" />
			<OnHide function="StoryTellerDialogTemplate_OnHide" />
		</Scripts>
		<Frames>
			<Frame parentKey="Border" inherits="DialogBorderTemplate" />
			<Button name="$parentCloseButton" parentKey="close" inherits="UIPanelCloseButton">
				<Anchors>
					<Anchor point="CENTER" relativePoint="TOPRIGHT">
						<Offset x="-7" y="-7" />
					</Anchor>
				</Anchors>
			</Button>
		</Frames>
	</Frame>
</Ui>